{
  "name": "manualbox-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --test --disable-warning=ExperimentalWarning \"*-test.ts\"",
    "preview": "vite preview",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "generate:api": "echo \"types are hand-written in src/api/types.ts; see docs/api/openapi.yaml\""
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "prettier": "^3.6.0",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  }
}
