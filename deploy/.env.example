# Copy to deploy/.env and edit. Every value here has a working default, so an
# empty file is a valid configuration.

# --- basics -------------------------------------------------------------------

# Host port to publish on.
MANUALBOX_PORT=7745

# How you actually reach the instance. This is embedded in notifications and in
# the ICS calendar feed, which your calendar app fetches from outside the
# container — a wrong value shows up as unreachable links, not a startup error.
MANUALBOX_BASE_URL=http://localhost:7745

# Languages you read, most preferred first, as BCP-47 tags.
MANUALBOX_LANGUAGES=en

# OCR languages are derived from the above, but tesseract data has to be baked
# into the image at build time. List the codes you need here.
MANUALBOX_TESSERACT_LANGS=eng

MANUALBOX_LOG_LEVEL=info

# --- behind a reverse proxy ----------------------------------------------------

# Only enable this if a proxy in front of manualbox sets X-Forwarded-For. When
# false, forwarded headers are ignored so a client cannot forge its own address
# in the logs and session records.
# MANUALBOX_TRUST_PROXY=true

# --- optional AI providers ----------------------------------------------------
#
# Leave all of this unset and manualbox still stores, converts, OCRs, searches,
# and schedules. Only translation and maintenance extraction need a model.
#
# Listed cheapest-first. Prefer whatever you already pay for; a metered API key
# means a new bill for something you may already be paying for once.
# See docs/design/providers.md.

# 1) Free forever — a local model on your own hardware. No key, no egress, no
#    per-token cost. Needs roughly 8 GB of VRAM to be pleasant.
# MANUALBOX_TRANSLATE_KIND=ollama
# MANUALBOX_TRANSLATE_MODEL=qwen3:14b
# MANUALBOX_TRANSLATE_BASE_URL=http://host.docker.internal:11434

# 2) No extra cost — drive a CLI you have already logged into, so the work counts
#    against your existing Claude / ChatGPT plan instead of a card. The CLI must
#    be installed and its credential reachable from the container, and the limit
#    you hit is your plan's usage window rather than a bill.
#    Read the caveats in docs/design/providers.md before enabling this: using a
#    subscription CLI from a server is your call to make about your own account.
# MANUALBOX_TRANSLATE_KIND=claude-cli
# MANUALBOX_TRANSLATE_KIND=codex-cli

# 3) Metered — a per-token API key. Best throughput and the only path that can
#    guarantee schema-valid output, but it bills per request.
#    (A Claude or ChatGPT subscription is not API access; these are separate keys.)
# MANUALBOX_TRANSLATE_KIND=claude
# MANUALBOX_TRANSLATE_MODEL=claude-sonnet-5
# MANUALBOX_TRANSLATE_API_KEY=sk-ant-...
#
# DeepL, if you would rather use a dedicated translation service:
# MANUALBOX_TRANSLATE_KIND=deepl
# MANUALBOX_TRANSLATE_API_KEY=...

# Maintenance extraction reads the manual and proposes a schedule. It is a
# harder task than translation and benefits from a stronger model — but it runs
# once per document, not once per paragraph, so it is cheap either way.
# MANUALBOX_EXTRACT_KIND=claude-cli
# MANUALBOX_EXTRACT_KIND=ollama
# MANUALBOX_EXTRACT_MODEL=qwen3:14b
