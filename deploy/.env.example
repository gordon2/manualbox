# Copy to deploy/.env and edit. Every value here has a working default, so an
# empty file is a valid configuration.

# --- basics -------------------------------------------------------------------

# Host port to publish on.
MANUALBOX_PORT=7745

# How you actually reach the instance. This is embedded in notifications and in
# the ICS calendar feed, which your calendar app fetches from outside the
# container — a wrong value shows up as unreachable links, not a startup error.
MANUALBOX_BASE_URL=http://localhost:7745

# Languages you read, most preferred first, as BCP-47 tags.
MANUALBOX_LANGUAGES=en

# OCR languages are derived from the above, but tesseract data has to be baked
# into the image at build time. List the codes you need here.
MANUALBOX_TESSERACT_LANGS=eng

MANUALBOX_LOG_LEVEL=info

# --- behind a reverse proxy ----------------------------------------------------

# Only enable this if a proxy in front of manualbox sets X-Forwarded-For. When
# false, forwarded headers are ignored so a client cannot forge its own address
# in the logs and session records.
# MANUALBOX_TRUST_PROXY=true

# --- optional AI providers ----------------------------------------------------
#
# Leave these unset and manualbox still stores, converts, OCRs, searches, and
# schedules — only translation and maintenance extraction need a provider. Mix
# freely: local conversion with cloud translation is a normal setup.
#
# Anthropic (per-token API key from console.anthropic.com; a Claude subscription
# is not API access):
# MANUALBOX_TRANSLATE_KIND=claude
# MANUALBOX_TRANSLATE_MODEL=claude-sonnet-5
# MANUALBOX_TRANSLATE_API_KEY=sk-ant-...
#
# Fully local via Ollama on the host (no key, no network egress):
# MANUALBOX_TRANSLATE_KIND=ollama
# MANUALBOX_TRANSLATE_MODEL=qwen3:14b
# MANUALBOX_TRANSLATE_BASE_URL=http://host.docker.internal:11434
#
# DeepL, if you would rather use a dedicated translation service:
# MANUALBOX_TRANSLATE_KIND=deepl
# MANUALBOX_TRANSLATE_API_KEY=...
#
# Maintenance extraction reads the manual and proposes a schedule. It benefits
# from a stronger model than translation does.
# MANUALBOX_EXTRACT_KIND=claude
# MANUALBOX_EXTRACT_MODEL=claude-opus-5
# MANUALBOX_EXTRACT_API_KEY=sk-ant-...
