# build output
/bin/
/dist/
# Root-anchored: an unanchored "manualbox" would also match the cmd/manualbox
# source directory and silently exclude the entire command from the repo.
/manualbox

# runtime data (blobs, sqlite db) — never commit
/data/
*.db
*.db-shm
*.db-wal

# local config & secrets
.env
.env.local
config.local.yaml

# frontend
/web/node_modules/
/web/dist/
/web/.vite/
# Where `vite build --ssr reader-check.tsx` and `search-check.tsx` put their
# bundles. Both render a screen to HTML on the command line, which is what a
# headless browser is then pointed at to take a screenshot of an authenticated page.
/web/.reader-check/
/web/.search-check/
# Where `vite build --config folio-browser-check.vite.ts` puts its bundle. Unlike
# the two above this one is a whole page a browser opens directly, with a real
# document's conversion JSON compiled into it — which is the other reason it is
# never committed.
/web/.folio-check*/
*.tsbuildinfo

# go
/vendor/
coverage.out
coverage.html

# editors / os
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# scratch
/tmp/
/scratch/

# Agent worktrees. Root-anchored for the same reason as /manualbox above: these
# are checkouts of this repository, and `git add -A` will otherwise stage one as
# an embedded repository.
/.claude/worktrees/

# Vite builds the SPA into internal/frontend/dist/app so it can be go:embed-ed.
# It writes into the app/ subdirectory rather than dist/ itself because Vite's
# emptyOutDir wipes its output directory on every build — which silently deleted
# the committed .gitkeep and broke `go build` on a fresh clone. Keeping the
# placeholder one level up puts it out of Vite's reach.
/internal/frontend/dist/app/
