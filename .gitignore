# build output
/bin/
/dist/
# Root-anchored: an unanchored "manualbox" would also match the cmd/manualbox
# source directory and silently exclude the entire command from the repo.
/manualbox

# runtime data (blobs, sqlite db) — never commit
/data/
*.db
*.db-shm
*.db-wal

# local config & secrets
.env
.env.local
config.local.yaml

# frontend
/web/node_modules/
/web/dist/
/web/.vite/
*.tsbuildinfo

# go
/vendor/
coverage.out
coverage.html

# editors / os
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# scratch
/tmp/
/scratch/

# Vite builds the SPA into internal/frontend/dist/app so it can be go:embed-ed.
# It writes into the app/ subdirectory rather than dist/ itself because Vite's
# emptyOutDir wipes its output directory on every build — which silently deleted
# the committed .gitkeep and broke `go build` on a fresh clone. Keeping the
# placeholder one level up puts it out of Vite's reach.
/internal/frontend/dist/app/
